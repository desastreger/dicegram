#!/usr/bin/env bash
# Summarise Caddy's access log.
#
#   scripts/traffic-report              # summary over the whole log
#   scripts/traffic-report --days 7     # last N days only
#   scripts/traffic-report --paths 30   # show more paths
#
# Run on the VPS, where the caddy_logs volume lives. Everything runs in
# throwaway containers, so nothing needs installing on the host.
#
# WHAT THIS CAN AND CANNOT TELL YOU
#
# The log deliberately stores no client address, no User-Agent and no
# Referer (see the Caddyfile). That means:
#
#   * There is NO unique-visitor count. Every total here is REQUESTS.
#   * There is NO crawler filtering, because filtering needs a User-Agent.
#     Raw page hits therefore include bot traffic and overstate real use.
#
# The number to watch instead is POST /api/render. The editor calls it on
# every debounced edit, so it tracks actual editing — and crawlers never
# generate it, because bots do not POST DSL payloads to a render endpoint.
# It is a smaller number than "hits" and a far more honest one.
#
# GoAccess is deliberately not used: it needs a host/IP field to parse a
# log at all, and this one has none by design.

set -uo pipefail

log()  { printf '\033[1;34m→\033[0m %s\n' "$*"; }
fail() { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

DAYS=0
PATHS=15
while (($#)); do
  case "$1" in
    --days)   DAYS="${2:-0}"; shift 2 ;;
    --days=*) DAYS="${1#*=}"; shift ;;
    --paths)  PATHS="${2:-15}"; shift 2 ;;
    --paths=*) PATHS="${1#*=}"; shift ;;
    -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
    *) shift ;;
  esac
done

command -v docker >/dev/null 2>&1 || fail "docker not found — run this on the VPS."

VOLUME=$(docker volume ls --format '{{.Name}}' | grep -E '_caddy_logs$' | head -1)
[ -n "$VOLUME" ] || fail "no *_caddy_logs volume found.
  Access logging may not be deployed yet:
    docker compose --profile caddy up -d --build"

# Caddy rolls to access-*.log; concatenate oldest first, then run everything
# through one jq pass inside a container so the host needs no jq.
docker run --rm -i -v "$VOLUME":/logs:ro alpine:3 sh -c '
  apk add --no-cache jq >/dev/null 2>&1 || exit 3
  cat $(ls -tr /logs/access*.log 2>/dev/null) 2>/dev/null |
  jq -rs --argjson days '"$DAYS"' --argjson paths '"$PATHS"' "
    (if \$days > 0 then (now - (\$days * 86400)) else 0 end) as \$cutoff
    | map(select(.ts >= \$cutoff)) as \$all
    | if (\$all | length) == 0 then
        \"no requests recorded in this window\"
      else
        (\$all | length) as \$total
        | (\$all | map(select(.request.uri == \"/api/render\")) | length) as \$renders
        | (\$all | map(select(.request.uri | startswith(\"/api/export\"))) | length) as \$exports
        | (\$all | map(select(.request.uri == \"/api/auth/signup\" and .status == 201)) | length) as \$signups
        | (\$all | map(select(.status >= 500)) | length) as \$errors
        | (\$all | map(select(.status == 429)) | length) as \$limited
        | [
            \"REQUESTS\",
            \"  total          \\(\$total)\",
            \"  renders        \\(\$renders)   <- real editing; bots never generate these\",
            \"  exports        \\(\$exports)\",
            \"  signups        \\(\$signups)\",
            \"  5xx            \\(\$errors)\",
            \"  rate-limited   \\(\$limited)\",
            \"\",
            \"RENDERS PER DAY\"
          ]
          + (\$all | map(select(.request.uri == \"/api/render\"))
                   | group_by(.ts | strftime(\"%Y-%m-%d\"))
                   | map(\"  \\(.[0].ts | strftime(\"%Y-%m-%d\"))   \\(length)\")
                   | .[-21:])
          + [\"\", \"TOP PATHS (includes bot traffic — no User-Agent to filter on)\"]
          + (\$all | group_by(.request.uri | split(\"?\")[0])
                   | sort_by(-length)
                   | map(\"  \\(length | tostring | (\"     \" + .)[-6:])  \\(.[0].request.uri | split(\"?\")[0])\")
                   | .[:\$paths])
          | .[]
      end
  "
' || fail "could not read the log (is the volume empty?)"

echo
log "requests, not people — this log stores no IP, User-Agent or Referer"
