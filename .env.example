# ─── Required ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string

# ─── Session / cookies ─────────────────────────────────────────────────────
# true = cookie only sent over HTTPS. Leave true for any real deployment.
SESSION_COOKIE_SECURE=true

# ─── Database ──────────────────────────────────────────────────────────────
# Default SQLite path lives on the dicegram_data volume. Override with a
# Postgres URL like: postgresql+psycopg://user:pass@host:5432/dicegram
DATABASE_URL=sqlite:////data/dicegram.db

# ─── Runtime ───────────────────────────────────────────────────────────────
# Number of uvicorn worker processes. 3 is the recommended cap on SQLite
# (single-writer); see README's Postgres section to safely go higher.
WEB_CONCURRENCY=3

# ─── App ────────────────────────────────────────────────────────────────
# Public base URL, used as an absolute reference by downstream URL builders
# (e.g. share links). Must be reachable from a user's browser.
# NOTE: there is no email/SMTP subsystem — Dicegram does not send email.
# Account recovery is via the on-page password hint only.
APP_BASE_URL=https://dicegram.example.com

# ─── Caddy (only needed when using the `caddy` compose profile) ───────────
# The domain Caddy will serve and request a Let's Encrypt cert for.
DOMAIN=dicegram.example.com
# Email used for ACME/Let's Encrypt registration and expiry notices.
ACME_EMAIL=you@example.com

# ─── Admin ─────────────────────────────────────────────────────────────────
# Who may read /api/admin/* and see /admin/stats. Both empty (the default)
# means NOBODY is an admin — a fresh instance exposes no admin surface.
#
# Set the username of an account that ALREADY EXISTS. It is resolved to an
# account id once at startup, and the id is what actually grants access.
ADMIN_USERNAMES=
#
# REGISTER THE ACCOUNT FIRST. A username is not a claim on anything: naming
# a handle nobody has taken means the first person to register it would
# become an administrator at the next restart. If the name does not resolve
# at boot it grants nothing, and the startup log says so.
#
# The startup log also prints the resolved id. Pinning it here makes admin
# access independent of the name entirely, which is the stronger setting:
ADMIN_USER_IDS=
