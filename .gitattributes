# Shell scripts and Dockerfiles must stay LF-terminated, otherwise
# `docker build` on Linux blows up with 'exec format error' on Windows checkouts.
*.sh            text eol=lf
Dockerfile      text eol=lf
docker-entrypoint.sh text eol=lf
Caddyfile       text eol=lf
scripts/restart-backend text eol=lf
scripts/ship    text eol=lf

# Windows batch scripts need CRLF or cmd.exe can misparse them.
*.bat           text eol=crlf
